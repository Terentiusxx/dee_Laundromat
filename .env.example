# Local Docker compose: only set this if you want a custom local DB password
LOCAL_POSTGRES_PASSWORD=local-change-me

# Railway: add these in each service's Variables panel, not in a committed .env.
# API service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DEMO_MODE=false
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://<YOUR-WEB-RAILWAY-DOMAIN>
# ALLOWED_ORIGINS=https://<YOUR-WEB-RAILWAY-DOMAIN>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# WEB service:
# API_INTERNAL_ORIGIN=http://api.railway.internal:8000
